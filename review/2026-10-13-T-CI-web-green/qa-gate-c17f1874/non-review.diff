+function findRepoRoot() {
+  for (const start of [process.cwd(), resolve(process.cwd(), '..')]) {
+    let dir = start;
+    for (let i = 0; i < 6; i++) {
+      if (existsSync(join(dir, 'src/pilot/config/loadPilotConfig.ts')) && existsSync(join(dir, 'package.json'))) {
