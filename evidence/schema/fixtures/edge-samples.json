{
  "description": "Raw JSON text → JSON.parse → schema and validateModuleMessage. Covers isSequence/isResumeSequence bounds, extra fields, empty/non-string ids, response.final non-booleans, exponent/overflow JSON numbers, and forbidden-field locality.",
  "samples": [
    {
      "id": "event-sequence-1.0",
      "bound": "isSequence",
      "expect": "accept",
      "tP1RustSerdeParseRisk": true,
      "note": "JSON.parse('1.0') is JS number 1; Number.isInteger(1) is true. Rust serde may keep f64.",
      "raw": "{\"kind\":\"event\",\"eventType\":\"model.delta\",\"streamId\":\"stream-1\",\"sequence\":1.0,\"runId\":\"run-1\",\"operationId\":\"operation-1\",\"requestId\":\"request-1\",\"final\":false,\"payload\":{}}"
    },
    {
      "id": "event-sequence-negative-zero",
      "bound": "isSequence",
      "expect": "accept",
      "tP1RustSerdeParseRisk": true,
      "note": "JSON.parse('-0') is JS -0; Number.isInteger(-0) && -0 >= 0. Rust serde may preserve sign.",
      "raw": "{\"kind\":\"event\",\"eventType\":\"model.delta\",\"streamId\":\"stream-1\",\"sequence\":-0,\"runId\":\"run-1\",\"operationId\":\"operation-1\",\"requestId\":\"request-1\",\"final\":false,\"payload\":{}}"
    },
    {
      "id": "event-sequence-negative-one",
      "bound": "isSequence",
      "expect": "reject",
