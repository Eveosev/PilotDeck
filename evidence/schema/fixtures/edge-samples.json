    },
    {
      "id": "event-sequence-above-2-pow-53",
      "bound": "isSequence",
      "expect": "accept",
      "tP1RustSerdeParseRisk": true,
      "token": "9007199254740993",
      "note": "JSON.parse loses precision above 2^53 but still yields an integer. Rust u64/i64 parse is exact and may disagree.",
      "raw": "{\"kind\":\"event\",\"eventType\":\"model.delta\",\"streamId\":\"stream-1\",\"sequence\":9007199254740993,\"runId\":\"run-1\",\"operationId\":\"operation-1\",\"requestId\":\"request-1\",\"final\":false,\"payload\":{}}"
    },
    {
      "id": "event-sequence-1e400",
      "bound": "isSequence",
      "expect": "reject",
      "tP1RustSerdeParseRisk": true,
      "token": "1e400",
      "note": "JSON.parse('1e400') is Infinity; Number.isInteger(Infinity) is false. Rust serde errors instead of becoming Infinity.",
      "raw": "{\"kind\":\"event\",\"eventType\":\"model.delta\",\"streamId\":\"stream-1\",\"sequence\":1e400,\"runId\":\"run-1\",\"operationId\":\"operation-1\",\"requestId\":\"request-1\",\"final\":false,\"payload\":{}}"
